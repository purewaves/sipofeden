{
  "name": "sipofeden",
  "version": "1.0.0",
  "description": "Sip of Eden Juice Bar",
  "main": "server/index.ts",
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel dev:backend dev:frontend",
    "dev:backend": "cross-env NODE_ENV=development tsx watch server/index.ts",
    "dev:frontend": "vite --config vite.config.ts",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "vite build",
    "build:backend": "tsc",
    "start": "node dist/server/index.js",
    "vercel-build": "npm run build",
    "db:push": "drizzle-kit push:pg",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate:pg"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.8.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.17.10",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.19",
    "@types/web-push": "^3.3.7",
    "@vercel/node": "^3.0.0",
    "bcrypt": "^5.1.1",
    "cloudinary": "^2.0.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.1",
    "drizzle-orm": "^0.29.3",
    "drizzle-orm/neon-serverless": "^0.29.3",
    "express": "^4.18.2",
    "express-session": "^1.18.0",
    "multer": "^1.4.5-lts.1",
    "npm-run-all": "^4.1.5",
    "pg": "^8.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "web-push": "^3.6.4"
  },
  "devDependencies": {
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "drizzle-kit": "^0.20.14",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
